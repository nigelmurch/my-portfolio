<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Music Debug Test</title>
<style>
  body { background: #000; color: #0ff; font-family: 'Press Start 2P', monospace; text-align:center; padding:5rem; }
  button {
    background:#111; color:#0ff; border:2px solid #0ff; padding:1rem 2rem;
    text-transform:uppercase; cursor:pointer; font-size:1rem;
  }
  button:hover { background:#0ff; color:#111; }
</style>
</head>
<body>

<h1>Music Debug Test</h1>
<p>If this works, your portfolio will too.</p>

<audio id="bg-music" src="sounds/bg-music.mp3" preload="auto" crossorigin="anonymous"></audio>
<button id="playBtn">▶ PLAY</button>

<script>
  const playBtn = document.getElementById("playBtn");
  const audioElement = document.getElementById("bg-music");

  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  const track = audioCtx.createMediaElementSource(audioElement);
  track.connect(audioCtx.destination);

  let isPlaying = false;

  playBtn.addEventListener("click", async () => {
    try {
      if (audioCtx.state === "suspended") {
        await audioCtx.resume();
        console.log("AudioContext resumed.");
      }
      if (!isPlaying) {
        await audioElement.play();
        isPlaying = true;
        playBtn.textContent = "⏸ PAUSE";
        console.log("🎵 Music started!");
      } else {
        audioElement.pause();
        isPlaying = false;
        playBtn.textContent = "▶ PLAY";
        console.log("⏸ Music paused!");
      }
    } catch (err) {
      console.error("Playback failed:", err);
      alert("🔇 Audio playback blocked or file not found. Try again.");
    }
  });
</script>

</body>
</html>
